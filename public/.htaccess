<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o carpeta existe, Apache lo sirve normal.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router: rutas como /ventas, /caja, /servicios vuelven a index.html.
  RewriteRule ^ index.html [L]
</IfModule>
